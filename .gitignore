# ─────────────────────────────────────────────────────────────────────────────
# Keep secrets, runtime data, local profiles and model weights out of git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets and environment (only .env.example is tracked) ───────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Runtime data ─────────────────────────────────────────────────────────────
data/
sessions/
groups/
backups/
Voices/

# ── Profiles: only the bundled example JSON files are tracked; per-profile ───
# ── runtime folders and databases are always ignored ─────────────────────────
profiles/*/
profiles/*.json
!profiles/example_luna.json
!profiles/example_luna_en.json
!profiles/example_mochi.json
!profiles/example_mochi_en.json

# ── SQLite / Chroma / vector stores (may live under profiles/) ───────────────
*.db
*.db-shm
*.db-wal
**/chroma_db/

# ── Models and weights (downloaded locally on demand) ────────────────────────
models/
*.bin
*.safetensors

# ── Node / Electron builds ───────────────────────────────────────────────────
node_modules/
dist/
release/
out/

# ── Runtime config that may contain local paths or session ids ───────────────
config/app.yaml
!config/app.yaml.example
config/sessions_meta.json
config/ui_prefs.json

# ── Electron: written by Python during startup ───────────────────────────────
startup_progress.json

# ── scripts: ignored by default; only the entries below are tracked ──────────
scripts/*
!scripts/start_gptsovits.bat
!scripts/start_gptsovits.sh
!scripts/check_runtime_deps.py
!scripts/build_binary.py
!scripts/setup_wizard_helper.py

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
**/logs/

# ── IDE / OS / build leftovers ───────────────────────────────────────────────
.vscode/
.idea/
.cursor/
*.swp
.DS_Store
Thumbs.db
/build
server.spec
server.exe
server
python_embed/
python_embed.zip
get-pip.py
user_packages/
/assets/readme/raw
test_models.py
test_models_results.md
test_models_lmstudio.py
test_models_lmstudio_results.md
