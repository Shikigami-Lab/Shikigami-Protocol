# Copy this file to .env and fill in your API keys.
# .env is gitignored — never commit real keys.
#
# Naming convention for LLM presets:
#   {PRESET_NAME_UPPER_WITH_SPACES_AS_UNDERSCORES}_API_KEY
#   e.g. preset "Gemini"  → GEMINI_API_KEY
#        preset "KIMI"    → KIMI_API_KEY
#        preset "MINIMAX" → MINIMAX_API_KEY

# ── Proxy Settings (Important for Local Dev) ──────────────────────────────────
# If you use a system proxy or VPN, uncomment this to prevent requests to the 
# local backend (Electron -> FastAPI) from being routed through your proxy.
# NO_PROXY="localhost,127.0.0.1,::1"

# ── Gemini (Google AI Studio — free tier available) ───────────────────────────
# https://aistudio.google.com/apikey
# Also used for Gemini embedding (memory vector search) — one key covers both.
GEMINI_API_KEY=

# ── Local Ollama (no key needed, leave as-is) ─────────────────────────────────
OLLAMA_LOCAL_API_KEY=ollama

# ── Other LLM providers (add as needed) ──────────────────────────────────────
# KIMI_API_KEY=
# MINIMAX_API_KEY=

# ── Embedding: OpenAI-compat provider only ────────────────────────────────────
# Only needed if memory.embedding.provider is set to "openai_compat".
# EMBEDDING_API_KEY=

# ── Content mode (optional) ────────────────────────────────────────────────────
# Public distribution builds: set PUBLIC_MODE=true to restrict emotion keys and
# related behavior (see server startup / persona tooling). Normal desktop use:
# leave unset or use false.
# PUBLIC_MODE=false

# ── Tools: WebSearch ──────────────────────────────────────────────────────────
# Leave empty to use free DuckDuckGo (limited results).
# Set to a Serper.dev key for full web search results.
# https://serper.dev
# WEBSEARCH_SERPER_API_KEY=
